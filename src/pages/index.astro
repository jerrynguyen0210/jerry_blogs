---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { getPosts } from '../lib/posts';
import { absoluteUrl, url } from '../lib/url';

const posts = await getPosts();
const recent = posts.slice(0, 5);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: site.title,
  description: site.description,
  url: absoluteUrl(),
  inLanguage: 'en-AU',
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.github,
    homeLocation: {
      '@type': 'Place',
      name: site.location,
    },
  },
};
---

<Base jsonLd={jsonLd}>
  <p class="kicker">{site.location}</p>
  <h1>{site.title}</h1>
  <p class="lede">
    I write about the work, the move from automotive into backend, and life in Adelaide. Casual on
    purpose.
  </p>
  <section aria-labelledby="recent-heading">
    <div class="section-head">
      <h2 id="recent-heading">Recent posts</h2>
      <a href={url('posts')}>All posts</a>
    </div>
    <PostList
      posts={recent}
      heading="h3"
      empty="Nothing published yet. The first post will show up here."
    />
  </section>
</Base>
