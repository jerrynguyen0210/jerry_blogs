---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Posts" description="Every post on Jerry Nguyen's blog, newest first.">
  <h1 class="page-title">Posts</h1>
  <p class="page-intro">Everything so far, newest first.</p>
  <PostList posts={posts} heading="h2" empty="No posts yet." />
</Base>
